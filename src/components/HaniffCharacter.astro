---
const asset = { day:'/characters/haniff-grounded-day.webp', night:'/characters/haniff-grounded-night.webp' };
---
<div class="character-stage" aria-hidden="true">
  <div class="grounded-scene">
    <span class="wave-frame wave-frame--day" aria-hidden="true"><img src={asset.day} alt="" width="1672" height="941" decoding="async"/></span>
    <span class="wave-frame wave-frame--night" aria-hidden="true"><img src={asset.night} alt="" width="1672" height="941" decoding="async"/></span>
  </div>
</div>
