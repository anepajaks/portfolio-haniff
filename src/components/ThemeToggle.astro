---
import Icon from './Icon.astro';
---
<button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch to night theme" aria-pressed="false" hidden>
  <span class="theme-toggle__icon" aria-hidden="true"><Icon name="sun" class="toggle-sun"/><Icon name="moon" class="toggle-moon"/></span>
  <span class="theme-day">Day</span><span class="theme-night">Night</span>
</button>
