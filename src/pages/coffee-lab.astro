---
import '../styles/coffee-lab.css';
import {drinks} from '../scripts/coffee-lab/menu';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Explore Coffee Lab, a little three-dimensional café in a living miniature neighbourhood." />
    <title>Coffee Lab — A little place to slow down</title>
  </head>
  <body>
    <main id="coffee-app">
      <canvas id="world" aria-label="Interactive 3D Coffee Lab. Drag to orbit, scroll to zoom. Use the camera buttons as a keyboard alternative." tabindex="0"></canvas>
      <header class="topbar">
        <a class="brand" href="/#projects" aria-label="Back to portfolio projects"><span class="brand-mark">c<span>l</span></span><span>COFFEE LAB<small>BY HANIFF · ← PROJECTS</small></span></a>
        <div class="top-actions"><span class="location"><i></i> A LITTLE CORNER OF THE CITY</span><button id="motion" aria-pressed="false">Pause city</button><button id="settings" aria-expanded="false" aria-controls="preferences">Settings</button></div>
      </header>
      <section id="preferences" class="preferences" hidden aria-label="Preferences">
        <label><input id="reduced-motion" type="checkbox" /> Reduced motion</label>
        <label>Graphics <select id="quality"><option value="balanced">Balanced</option><option value="low">Low</option><option value="high">High</option></select></label>
        <p>Reduced motion pauses city activity and makes camera changes instant.</p>
      </section>
      <section id="welcome" class="welcome">
        <p class="eyebrow">THE NEIGHBOURHOOD / 01</p>
        <h1>A little place<br />to slow down<span>.</span></h1>
        <p>Take a look around.<br />Your corner café is open.</p>
        <button id="enter" class="primary" disabled>Preparing the café… <span>↗</span></button>
        <span class="quiet">Drag to explore before you step inside</span>
      </section>
      <section id="interior" class="interior-panel" hidden>
        <p class="eyebrow">INSIDE COFFEE LAB</p>
        <div id="menu-picker">
          <h1>What shall we make<span>?</span></h1>
          <p>Choose your drink before heading to the grinder.</p>
          <div class="drink-options" role="group" aria-label="Choose your coffee">
            {drinks.map(drink=><button data-drink={drink.id} aria-pressed="false"><strong>{drink.name}</strong><span>{drink.ingredients}</span><small>{drink.lesson}</small></button>)}
          </div>
        </div>
        <div id="recipe-panel" hidden>
          <h1 id="drink-title"></h1>
          <p id="drink-ingredients"></p>
          <button id="change-drink">← Change drink</button>
          <p id="station-note" aria-live="polite">Start at the grinder.</p>
          <div class="stations" role="group" aria-label="Workstations"><button data-station="grinder" aria-pressed="false">01 · Grinder</button><button data-station="espresso" aria-pressed="false">02 · Espresso</button><button data-station="finish" aria-pressed="false">03 · Finishing</button></div>
          <p class="quiet">Explore your recipe’s stations. Hands-on brewing comes next.</p>
        </div>
        <button id="outside">← Back to the street</button>
      </section>
      <footer class="bottom-bar"><span id="view-label">EXTERIOR VIEW</span><div class="camera-controls" aria-label="Camera controls"><button id="left" aria-label="Rotate camera left">↶</button><button id="right" aria-label="Rotate camera right">↷</button><button id="zoom-in" aria-label="Zoom in">+</button><button id="zoom-out" aria-label="Zoom out">−</button><span class="divider"></span><button id="reset">Reset view</button><button id="orbit" aria-pressed="true">Auto orbit</button></div><span class="footnote">A SMALL WORLD, MADE WITH CARE</span></footer>
      <div id="error" class="error" role="alert" hidden><h2>The café couldn’t open</h2><p id="error-detail">Please enable hardware acceleration and try a browser with WebGL 2 support.</p><button onclick="location.reload()">Try again</button><a href="/">Back to portfolio</a></div>
      <noscript><div class="error">Please enable JavaScript to explore Coffee Lab.</div></noscript>
    </main>
    <script>
      import { startCoffeeLab } from '../scripts/coffee-lab/main';
      startCoffeeLab();
    </script>
  </body>
</html>
