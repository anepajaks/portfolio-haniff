---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Haniff's Portfolio</title>
    <!-- Import Font Poppins & Montserrat -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    
    <!-- TAMBAH is:inline DI SINI SUPAYA DESIGN TAK HILANG -->
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    
    <style>
      body { font-family: 'Montserrat', sans-serif; transition: background-color 0.5s, color 0.5s; }
      h1, h2, h3 { font-family: 'Poppins', sans-serif; }
      
      /* Animasi Matahari & Bulan Berpusing */
      .toggle-icon { transition: transform 0.6s ease-in-out; }
      .rotate-moon { transform: rotate(180deg); }
      
      /* Dark Mode Colors */
      .dark-mode { background-color: #1a1a1a; color: #f3f4f6; }
      .light-mode { background-color: #fdfbf7; color: #2d3748; }
    </style>
  </head>
  
  <body class="light-mode min-h-screen flex items-center justify-center overflow-hidden relative">
    
    <!-- Butang Toggle Siang/Malam -->
    <button id="theme-toggle" class="absolute top-8 right-8 w-14 h-14 bg-gray-200 dark:bg-gray-800 rounded-full flex items-center justify-center shadow-lg hover:scale-110 transition-transform z-50">
      <div id="icon-container" class="toggle-icon text-2xl relative w-full h-full flex items-center justify-center">
        <!-- Matahari -->
        <span id="sun" class="absolute transition-opacity duration-300">☀️</span>
        <!-- Bulan -->
        <span id="moon" class="absolute opacity-0 transition-opacity duration-300">🌙</span>
      </div>
    </button>

    <!-- Main Content Container (Grid) -->
    <main class="w-full max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-8 items-center h-screen">
      
      <!-- Kiri: Teks (Ambil 1/4 ruang) -->
      <div class="col-span-1 md:col-span-1 z-10 flex flex-col gap-4">
        <h2 class="text-xl text-[#8B5A2B] uppercase tracking-widest font-semibold">Hi, Welcome to</h2>
        <h1 class="text-5xl md:text-6xl font-bold leading-tight">Haniff's<br><span class="text-blue-500">Portfolio</span></h1>
        <p class="text-lg opacity-80 mt-2">Helpdesk Associate transitioning to IT & Networking Engineer.</p>
        
        <div class="mt-6 flex gap-4">
          <a href="/about" class="px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition">About Me</a>
          <a href="/project" class="px-6 py-3 border-2 border-blue-600 text-blue-600 dark:text-blue-400 font-semibold rounded-lg hover:bg-blue-50 dark:hover:bg-gray-800 transition">My Games</a>
        </div>
      </div>

      <!-- Kanan: Karakter (Ambil 3/4 ruang) -->
      <div class="col-span-1 md:col-span-3 relative h-full flex items-end justify-end pb-10">
        <!-- Bubble Speech -->
        <div class="absolute top-1/4 right-1/4 bg-white dark:bg-gray-800 text-black dark:text-white px-6 py-4 rounded-2xl shadow-xl z-20 animate-bounce">
          <p class="font-semibold text-lg">Hi, Welcome to Portfolio Haniff! 👋</p>
          <div class="absolute -bottom-2 right-10 transform rotate-45 w-4 h-4 bg-white dark:bg-gray-800"></div>
        </div>
        
        <!-- Placeholder Karakter 3D -->
        <img src="https://via.placeholder.com/600x800.png?text=3D+Character+Hoodie+Biru" alt="Haniff 3D Character" class="h-[70vh] object-contain drop-shadow-2xl z-10">
      </div>
    </main>

    <!-- TAMBAH is:inline DI SINI JUGA -->
    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      const body = document.body;
      const iconContainer = document.getElementById('icon-container');
      const sun = document.getElementById('sun');
      const moon = document.getElementById('moon');

      btn.addEventListener('click', () => {
        iconContainer.classList.toggle('rotate-moon');
        if (body.classList.contains('light-mode')) {
          body.classList.replace('light-mode', 'dark-mode');
          sun.classList.replace('opacity-100', 'opacity-0');
          moon.classList.replace('opacity-0', 'opacity-100');
        } else {
          body.classList.replace('dark-mode', 'light-mode');
          moon.classList.replace('opacity-100', 'opacity-0');
          sun.classList.replace('opacity-0', 'opacity-100');
        }
      });
    </script>
  </body>
</html>
