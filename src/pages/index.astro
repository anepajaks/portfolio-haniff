---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Portfolio Haniff</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    
    <style>
      body { font-family: 'Montserrat', sans-serif; overflow: hidden; margin: 0; }
      h1, h2, h3, nav a { font-family: 'Poppins', sans-serif; }
      
      /* Latar Belakang Langit */
      .sky-light { background: linear-gradient(to bottom, #87CEEB, #e0f6ff); color: #1f2937; }
      .sky-dark { background: linear-gradient(to bottom, #0f2027, #203a43); color: #f9fafb; }
      
      /* Rumput */
      .grass-light { fill: #4ade80; } /* Hijau cerah */
      .grass-dark { fill: #064e3b; }  /* Hijau/Biru sangat gelap untuk malam */

      /* Animasi Putaran Matahari/Bulan */
      #celestial-wheel { transition: transform 1.5s cubic-bezier(0.4, 0, 0.2, 1); }
    </style>
  </head>
  
  <body id="body-bg" class="sky-light relative h-screen w-screen flex flex-col items-center transition-colors duration-1000">
    
    <!-- NAVIGATION BAR -->
    <header class="absolute top-0 w-full p-6 flex justify-center md:justify-end items-center z-50">
      <nav class="flex gap-6 font-semibold text-sm md:text-lg bg-white/20 dark:bg-black/20 backdrop-blur-md px-6 py-2 rounded-full shadow-sm transition-colors">
        <a href="/" class="hover:text-blue-600 transition">Home</a>
        <a href="/about" class="hover:text-blue-600 transition">About</a>
        <a href="/project" class="hover:text-blue-600 transition">Projects</a>
        <a href="/contact" class="hover:text-blue-600 transition">Contact</a>
      </nav>
      
      <!-- Butang Toggle Day/Night -->
      <button id="theme-toggle" class="ml-4 w-10 h-10 bg-white/50 dark:bg-black/50 rounded-full flex items-center justify-center hover:scale-110 transition shadow backdrop-blur-md z-50">
        🌓
      </button>
    </header>

    <!-- TEXT CONTENT (Terapung di Langit) -->
    <div class="absolute top-[12%] md:top-[15%] w-full px-6 text-center z-40 drop-shadow-md">
      <h2 class="text-lg md:text-xl text-blue-600 dark:text-blue-400 font-bold uppercase tracking-widest transition-colors">Hi, I'm Haniff 👋</h2>
      <h1 class="text-4xl md:text-6xl font-extrabold mt-2 leading-tight">Helpdesk to <br><span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-teal-400">IT Engineer</span></h1>
      <p class="mt-4 text-sm md:text-lg opacity-80 font-medium max-w-2xl mx-auto">
        I solve problems, build networks, and create games. Check out my Coffee Lab & Networking projects!
      </p>
      <div class="mt-6 flex justify-center gap-4">
        <a href="/project" class="px-6 py-3 md:px-8 md:py-3 bg-blue-600 text-white font-bold rounded-full hover:bg-blue-700 transition shadow-lg hover:-translate-y-1">Play My Games</a>
      </div>
    </div>

    <!-- TAYAR MATAHARI & BULAN (Z-10: Belakang Rumput) -->
    <!-- Paksi putaran duduk di tengah bawah skrin, jadi ia akan membentuk arc / lengkungan -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 w-[400px] h-[400px] md:w-[700px] md:h-[700px] z-10 pointer-events-none">
      <div id="celestial-wheel" class="relative w-full h-full" style="transform: rotate(0deg);">
        <!-- Matahari -->
        <img src="https://cdn-icons-png.flaticon.com/512/869/869869.png" alt="Sun" class="absolute -top-10 left-1/2 -translate-x-1/2 w-20 h-20 md:w-32 md:h-32 drop-shadow-[0_0_40px_rgba(255,215,0,1)]">
        <!-- Bulan -->
        <img src="https://cdn-icons-png.flaticon.com/512/1296/1296066.png" alt="Moon" class="absolute -bottom-10 left-1/2 -translate-x-1/2 rotate-180 w-16 h-16 md:w-28 md:h-28 drop-shadow-[0_0_30px_rgba(255,255,255,0.8)]">
      </div>
    </div>

    <!-- RUMPUT / BUKIT (Z-20: Depan Matahari) -->
    <!-- Dilukis guna SVG membentuk bukit lembut -->
    <svg viewBox="0 0 1440 320" preserveAspectRatio="none" class="absolute bottom-0 w-full h-[30vh] md:h-[35vh] z-20">
      <path id="grass" class="grass-light transition-colors duration-1000" d="M0,320 L0,150 C480,0 960,0 1440,150 L1440,320 Z"></path>
    </svg>

    <!-- KARAKTER BARING (Z-30: Atas Rumput) -->
    <img src="https://cdn3d.iconscout.com/3d/premium/thumb/boy-using-laptop-while-lying-down-5692601-4743371.png" alt="Haniff Lying on Grass" class="absolute bottom-[23vh] md:bottom-[28vh] left-1/2 -translate-x-1/2 w-52 md:w-80 z-30 drop-shadow-[0_20px_20px_rgba(0,0,0,0.3)] hover:scale-105 transition-transform duration-500">

    <!-- SCRIPT LOGIK -->
    <script is:inline>
      const btn = document.getElementById('theme-toggle');
      const bodyBg = document.getElementById('body-bg');
      const wheel = document.getElementById('celestial-wheel');
      const grass = document.getElementById('grass');
      
      let isDark = false;
      let rotationDegree = 0;

      btn.addEventListener('click', () => {
        isDark = !isDark;
        
        // Putaran tayar
        rotationDegree += 180;
        wheel.style.transform = `rotate(${rotationDegree}deg)`;
        
        if (isDark) {
          bodyBg.classList.replace('sky-light', 'sky-dark');
          grass.classList.replace('grass-light', 'grass-dark');
          document.documentElement.classList.add('dark');
        } else {
          bodyBg.classList.replace('sky-dark', 'sky-light');
          grass.classList.replace('grass-dark', 'grass-light');
          document.documentElement.classList.remove('dark');
        }
      });
    </script>
  </body>
</html>
